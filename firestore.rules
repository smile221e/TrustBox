rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function corporateEmail() {
      return signedIn()
        && request.auth.token.email is string
        && authEmail().matches('.*@221e\\.space$');
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function emailAdminDoc() {
      return get(/databases/$(database)/documents/adminEmails/$(authEmail())).data;
    }

    function isAdmin() {
      return signedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && adminDoc().role in ['admin', 'super_admin'])
        || (exists(/databases/$(database)/documents/adminEmails/$(authEmail()))
          && emailAdminDoc().role in ['admin', 'super_admin'])
        || (exists(/databases/$(database)/documents/adminInvites/$(authEmail()))
          && get(/databases/$(database)/documents/adminInvites/$(authEmail())).data.role
              in ['admin', 'super_admin'])
      );
    }

    function isSuperAdmin() {
      return signedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && adminDoc().role == 'super_admin')
        || (exists(/databases/$(database)/documents/adminEmails/$(authEmail()))
          && emailAdminDoc().role == 'super_admin')
        || authEmail() == 'smile@221e.space'
      );
    }

    function isTopicId(value) {
      return value in [
        'manager_communication', 'salary', 'work_conditions', 'team',
        'learning', 'ideas', 'ethics', 'thanks', 'other'
      ];
    }

    function isLanguage(value) {
      return value in ['uk', 'en', 'es'];
    }

    function validRecipientId(value) {
      return value is string
        && value.size() >= 1
        && value.size() <= 64;
    }

    function intField(data, key) {
      return key in data && data[key] is int ? data[key] : 0;
    }

    function isBootstrapSuperAdminCreate() {
      return signedIn()
        && authEmail() == 'smile@221e.space'
        && request.resource.data.email == 'smile@221e.space'
        && request.resource.data.role == 'super_admin'
        && request.resource.data.displayName is string
        && request.resource.data.keys().hasAll(['email', 'displayName', 'role', 'createdAt', 'updatedAt']);
    }

    function isAllowlistClaimCreate() {
      return signedIn()
        && request.resource.data.email == authEmail()
        && request.resource.data.role in ['admin', 'super_admin']
        && request.resource.data.displayName is string
        && request.resource.data.keys().hasAll(['email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && (
          (exists(/databases/$(database)/documents/adminEmails/$(authEmail()))
            && request.resource.data.role
              == get(/databases/$(database)/documents/adminEmails/$(authEmail())).data.role)
          || (exists(/databases/$(database)/documents/adminInvites/$(authEmail()))
            && request.resource.data.role
              == get(/databases/$(database)/documents/adminInvites/$(authEmail())).data.role)
        );
    }

    match /feedback/{id} {
      allow read: if isAdmin()
        || (corporateEmail() && resource.data.allowPublicReply == true);

      allow create: if corporateEmail()
        && request.resource.data.accessEmail == authEmail()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.type in ['anonymous', 'identified']
        && isTopicId(request.resource.data.topicId)
        && validRecipientId(request.resource.data.recipientId)
        && request.resource.data.recipientName is string
        && request.resource.data.recipientName.size() >= 1
        && request.resource.data.recipientName.size() <= 120
        && isLanguage(request.resource.data.language)
        && request.resource.data.allowPublicReply is bool
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 20
        && request.resource.data.message.size() <= 4000
        && request.resource.data.heartCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.keys().hasAll([
          'type', 'topicId', 'message', 'recipientId', 'recipientName',
          'status', 'language', 'accessEmail', 'createdByUid',
          'createdAt', 'updatedAt', 'name', 'nickname', 'email',
          'allowPublicReply', 'heartCount', 'commentCount'
        ]);

      allow update: if (isAdmin()
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(['status', 'updatedAt']))
        || (corporateEmail()
            && resource.data.allowPublicReply == true
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['heartCount'])
            && request.resource.data.heartCount is int
            && request.resource.data.heartCount >= 0
            && (request.resource.data.heartCount == intField(resource.data, 'heartCount') + 1
                || request.resource.data.heartCount == intField(resource.data, 'heartCount') - 1))
        || (corporateEmail()
            && resource.data.allowPublicReply == true
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['commentCount'])
            && request.resource.data.commentCount is int
            && request.resource.data.commentCount
                == intField(resource.data, 'commentCount') + 1);

      allow delete: if isSuperAdmin();
    }

    match /feedbackHearts/{id} {
      allow read: if corporateEmail()
        && (!exists(/databases/$(database)/documents/feedbackHearts/$(id))
            || resource.data.uid == request.auth.uid);

      allow create: if corporateEmail()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.feedbackId is string
        && id == request.resource.data.feedbackId + '_' + request.auth.uid;

      allow delete: if corporateEmail()
        && resource.data.uid == request.auth.uid;
    }

    match /feedbackComments/{id} {
      allow read: if corporateEmail()
        && exists(/databases/$(database)/documents/feedback/$(resource.data.feedbackId))
        && get(/databases/$(database)/documents/feedback/$(resource.data.feedbackId)).data.allowPublicReply == true;

      allow create: if corporateEmail()
        && request.resource.data.feedbackId is string
        && exists(/databases/$(database)/documents/feedback/$(request.resource.data.feedbackId))
        && get(/databases/$(database)/documents/feedback/$(request.resource.data.feedbackId)).data.allowPublicReply == true
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 2
        && request.resource.data.body.size() <= 2000
        && request.resource.data.createdByUid == request.auth.uid;

      allow update, delete: if isSuperAdmin();
    }

    match /feedbackReplies/{id} {
      allow read: if isAdmin()
        || (corporateEmail() && resource.data.isPublic == true);

      allow create: if isAdmin()
        && request.resource.data.feedbackId is string
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 2
        && request.resource.data.body.size() <= 4000
        && request.resource.data.sentByAdminId == request.auth.uid
        && request.resource.data.sentByEmail == authEmail()
        && request.resource.data.deliveryStatus == 'accepted'
        && request.resource.data.isPublic is bool
        && request.resource.data.topicId is string
        && isTopicId(request.resource.data.topicId)
        && request.resource.data.questionText is string
        && request.resource.data.questionText.size() >= 1
        && request.resource.data.questionText.size() <= 4000
        && request.resource.data.authorKind in ['anonymous', 'identified']
        && request.resource.data.authorName is string
        && request.resource.data.feedbackStatus in ['new', 'in_progress', 'closed']
        && request.resource.data.adminDisplayName is string
        && request.resource.data.upvoteCount is int
        && request.resource.data.upvoteCount == 0;

      allow update: if isAdmin()
          && request.resource.data.diff(resource.data).changedKeys()
              .hasOnly([
                'isPublic', 'questionText', 'authorKind', 'authorName',
                'feedbackStatus', 'adminDisplayName', 'upvoteCount'
              ])
        || (corporateEmail()
            && resource.data.isPublic == true
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['upvoteCount'])
            && request.resource.data.upvoteCount is int
            && request.resource.data.upvoteCount >= 0
            && (request.resource.data.upvoteCount == resource.data.upvoteCount + 1
                || request.resource.data.upvoteCount == resource.data.upvoteCount - 1));

      allow delete: if isSuperAdmin();
    }

    match /replyVotes/{id} {
      // Allow get on missing docs (vote check); existing votes only by owner.
      allow read: if corporateEmail()
        && (!exists(/databases/$(database)/documents/replyVotes/$(id))
            || resource.data.uid == request.auth.uid);

      allow create: if corporateEmail()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.replyId is string
        && id == request.resource.data.replyId + '_' + request.auth.uid;

      allow delete: if corporateEmail()
        && resource.data.uid == request.auth.uid;
    }

    match /recipients/{id} {
      // Employees need names for the form; emails are corporate-internal.
      allow read: if corporateEmail() || isAdmin();

      allow create, update: if isAdmin()
        && validRecipientId(id)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.isActive is bool
        && request.resource.data.sortOrder is int;

      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if request.auth.uid == uid
        && (isBootstrapSuperAdminCreate() || isAllowlistClaimCreate());

      allow update, delete: if isSuperAdmin();
    }

    // Immediate admin allowlist by email (no email invite is sent).
    match /adminEmails/{email} {
      allow read: if isSuperAdmin()
        || (signedIn() && authEmail() == email);

      allow create, update: if isSuperAdmin()
        && request.resource.data.email == email
        && request.resource.data.email.matches('.*@221e\\.space$')
        && request.resource.data.role in ['admin', 'super_admin'];

      allow delete: if isSuperAdmin();
    }

    // Legacy — kept readable so old pending invites still work until migrated.
    match /adminInvites/{email} {
      allow read: if isSuperAdmin()
        || (signedIn() && authEmail() == email);

      allow create, update: if isSuperAdmin()
        && request.resource.data.email == email
        && request.resource.data.email.matches('.*@221e\\.space$')
        && request.resource.data.role in ['admin', 'super_admin'];

      allow delete: if isSuperAdmin();
    }

    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /auditLogs/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
