rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function corporateEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('.*@221e\\.space$');
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().role in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return isAdmin() && adminDoc().role == 'super_admin';
    }

    function isTopicId(value) {
      return value in [
        'manager_communication', 'salary', 'work_conditions', 'team',
        'learning', 'ideas', 'ethics', 'thanks', 'other'
      ];
    }

    function isRecipientId(value) {
      return value in [
        'unspecified', 'owner', 'ceo', 'hrd', 'sfo', 'tso', 'cco', 'cmo'
      ];
    }

    function isLanguage(value) {
      return value in ['uk', 'en', 'es'];
    }

    // Employees with @221e.space may create feedback; only admins read.
    match /feedback/{id} {
      allow read: if isAdmin();

      allow create: if corporateEmail()
        && request.resource.data.accessEmail == request.auth.token.email.lower()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.type in ['anonymous', 'identified']
        && isTopicId(request.resource.data.topicId)
        && isRecipientId(request.resource.data.recipientId)
        && isLanguage(request.resource.data.language)
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 20
        && request.resource.data.message.size() <= 4000
        && request.resource.data.keys().hasAll([
          'type', 'topicId', 'message', 'recipientId', 'recipientName',
          'status', 'language', 'accessEmail', 'createdByUid',
          'createdAt', 'updatedAt', 'name', 'nickname', 'email'
        ]);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['status', 'updatedAt']);

      allow delete: if isSuperAdmin();
    }

    match /feedbackReplies/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /recipients/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /auditLogs/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
