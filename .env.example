# Public Vite env (safe for client bundle — no secrets)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# Local emulators (optional). Requires: firebase emulators:start
# VITE_USE_FIREBASE_EMULATOR=true

# GitHub Pages base path. Use "/" for custom domain / user site.
# Example project site: /trustbox/
VITE_BASE_PATH=/trustbox/

# --- Server-only (Cloud Functions / local Vite access API — never VITE_*) ---
# PeopleForce Company API key (Settings → API keys). Never commit the real key.
PEOPLEFORCE_API_KEY=
# Top-level department IDs: 221e + ITC (nested teams are included automatically)
PEOPLEFORCE_ALLOWED_DEPARTMENT_IDS=99123,38131
# PEOPLEFORCE_BASE_URL=https://app.peopleforce.io/api/public/v3

# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# DEFAULT_NOTIFICATION_EMAIL=
