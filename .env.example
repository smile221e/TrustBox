# Public Vite env (safe for client bundle — no secrets)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# GitHub Pages base path. Use "/" for custom domain / user site.
# Example project site: /TrustBox/
VITE_BASE_PATH=/trustbox/

# --- Recipient email notify (pick ONE; optional) ---
# 1) Webhook (Make.com / Google Apps Script / n8n) — POST JSON { to, subject, text, ... }
# VITE_NOTIFY_WEBHOOK_URL=

# 2) EmailJS (https://www.emailjs.com/) — template must include {{to_email}} and {{message}}
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
